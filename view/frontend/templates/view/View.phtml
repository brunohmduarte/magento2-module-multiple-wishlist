<?php
/**
 * @var \BrunoDuarte\MultipleWishlist\ViewModel\View\ItemsList $viewModel
 * @var \Magento\Framework\View\Element\Template $block
 */

$viewModel = $block->getData('multiple_wishlist_items_list');
$wishlist = $viewModel->getWishlist();
?>

<?php if (empty($wishlist)): ?>
    <p class="empty">Wishlist is empty</p>
<?php endif; ?>

<?php if (!empty($wishlist)): ?>
    <h1 class="page-title">
        <span class="base" data-ui-id="page-title-wrapper"><?= __('Wishlist Items: %1', $wishlist->getTitle()) ?></span>
    </h1>

    <div accesskey="" class="block block-wishlist">
        <div class="table-wrapper">
            <table class="data table">
                <thead>
                    <tr>
                        <th scope="col" class="col"><?= __('Product') ?></th>
                        <th scope="col" class="col"><?= __('Name') ?></th>
                        <th scope="col" class="col"><?= __('Price') ?></th>
                        <th scope="col" class="col"><?= __('Action') ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($viewModel->getWishlistItems() as $item): ?>
                        <tr class="col">
                            <td class="col" width="15%">
                                <img src="<?= $item['image'] ?>" alt="<?= $item['name'] ?>" style="width: 100px; height: 100px; object-fit: cover;" />
                            </td>
                            <td class="col" width="60%">
                                <div class="product-item-details">
                                    <strong class="product-item-name">
                                        <a href="<?= $item['product_url'] ?>"><?= $item['name'] ?></a>
                                    </strong>
                                    <span class="product-item-sku">SKU: <?= $item['sku'] ?></span>
                                </div>
                            </td>
                            <td class="col" width="15%">
                                <span style="font-size:14px; line-height:100px; font-weight:500; color:black;"><?= $item['price'] ?></span>
                            </td>
                            <td class="col" width="10%" style="font-size:14px; line-height:100px; font-weight:normal; color:#999;">
                                <a class="action view" href="<?= $item['url_remove'] ?>">Remover</a>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                        <tr class="col">
                            <td class="col" colspan="4">
                                <span style="font-size:14px; line-height:100px; font-weight:normal; color:#999;">Total de itens: <?= count($viewModel->getWishlistItems()) ?></span>
                            </td>
                        </tr>
                        <tr class="col">
                            <td class="col" colspan="4">
                                <span style="font-size:14px; line-height:100px; font-weight:normal; color:#999;">
                                    A lista de desejos não possui itens. Adicione produtos à sua lista de desejos para visualizá-los aqui.
                                </span>
                            </td>
                        </tr>
                </tbody>
            </table>
        </div>
    </div>
<?php endif; ?>
