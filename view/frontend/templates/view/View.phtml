<?php
/**
 * @var \BrunoDuarte\MultipleWishlist\ViewModel\View\ItemsList $viewModel
 * @var \Magento\Framework\View\Element\Template $block
 */

$viewModel = $block->getData('multiple_wishlist_items_list');
$wishlistItems = $viewModel->getWishlistItems();
$dataHelper = $this->helper(\BrunoDuarte\MultipleWishlist\Helper\Data::class);
$urlHelper = $this->helper(\BrunoDuarte\MultipleWishlist\Helper\Url::class);
?>

<h1 class="page-title" style="margin-top:1.5rem;">
    <span class="base" data-ui-id="page-title-wrapper"><?= __('Wishlist Items: %1', $viewModel->getWishlistTitle()) ?></span>
</h1>

<?php if (empty($wishlistItems)): ?>
    <p class="empty">
        <span style="font-size:14px; line-height:100px; font-weight:normal; color:#999;">
            A lista de desejos não possui itens. Adicione produtos à sua lista de desejos para visualizá-los aqui.
        </span>
    </p>
<?php endif; ?>

<?php if (!empty($wishlistItems)): ?>
    <div class="multiple-wishlist-header" style="width:100%;">
        <div class="actions-btn" style="display:flex; justify-content:flex-start;margin-top:1.5rem;margin-bottom:1.5rem;">
            <a class="" href="<?= $escaper->escapeUrl($urlHelper->getRouteUrl('multiple_wishlist/cart/add', ['id' => $viewModel->getWishlistId()])) ?>" style="padding: .5rem 1rem; border-right: 1px solid #999;">
                <span>Adicionar ao carrinho</span>
            </a>

            <a class="" href="<?= $escaper->escapeUrl($urlHelper->getRouteUrl('multiple_wishlist/page/listing')) ?>" style="padding: .5rem 1rem">
                <span>Voltar</span>
            </a>
        </div>
    </div>

    <div accesskey="" class="block block-wishlist">
        <div class="table-wrapper">
            <table class="data table">
                <thead>
                    <tr>
                        <th scope="col" class="col"><?= __('Product') ?></th>
                        <th scope="col" class="col"><?= __('Name') ?></th>
                        <th scope="col" class="col"><?= __('Price') ?></th>
                        <th scope="col" class="col"><?= __('Action') ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($wishlistItems['product'] as $product): ?>
                        <tr class="col">
                            <td class="col" width="15%">
                                <img src="<?= $escaper->escapeUrl($urlHelper->getProductImageUrl($product['_product'], $product['swatch_image'])) ?>" alt="<?= $escaper->escapeHtmlAttr($product['name']) ?>" style="width: 100px; height: 100px; object-fit: cover;" />
                            </td>
                            <td class="col" width="60%">
                                <div class="product-item-details">
                                    <a href="<?= $escaper->escapeUrl($urlHelper->getProductUrl($product['_product'])) ?>">
                                        <strong class="product-item-name">
                                            <?= $escaper->escapeHtml($product['name']) ?>
                                        </strong>
                                    </a>
                                    <span class="product-item-sku"><b>SKU:</b> <?= $product['sku'] ?></span>
                                </div>
                            </td>
                            <td class="col" width="15%">
                                <span style="font-size:14px; line-height:100px; font-weight:500; color:black;"><?= $dataHelper->getPrice($product['price']) ?></span>
                            </td>
                            <td class="col" width="10%" style="font-size:14px; line-height:100px; font-weight:normal; color:#999;">
                                <a href="<?= $escaper->escapeUrl($urlHelper->getRemoveFromWishlistUrl($product['_product'])) ?>">
                                    <span class="action view">Remover</span>
                                </a>
                            </td>
                        </tr>
                    <?php endforeach; ?>

                    <tr class="col">
                        <td class="col" colspan="4">
                            <span style="font-size:14px; line-height:100px; font-weight:normal; color:#999;">Total de itens: <?= count($wishlistItems['product']) ?></span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
<?php endif; ?>
